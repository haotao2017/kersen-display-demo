# Backend
API_PORT=4000
MQTT_TCP_PORT=1883
MQTT_WS_PATH=/mqtt
# embedded = this app starts a local Aedes broker.
# external = this app connects to your EMQX TCP listener and publishes commands there.
MQTT_MODE=embedded
EMQX_HOST=
EMQX_PORT=1883
EMQX_TLS=false
EMQX_VALIDATE_CERTIFICATE=true
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_CLIENT_ID=kersen-esl-cloud
JWT_SECRET=change-me-before-production
CORS_ORIGIN=http://localhost:5173
CONSOLE_URL=http://localhost:5173
# For real base stations, set this to a LAN IP or public domain, never localhost.
PUBLIC_SERVER_URL=http://YOUR_LAN_IP:4000

# Optional upstream compatibility target discovered from the legacy platform.
# Put the supplied cloud username/password in your private .env only.
UPSTREAM_CLOUD_URL=http://43.153.107.21
UPSTREAM_STORE_CODE=20248517
UPSTREAM_USERNAME=20248517
UPSTREAM_PASSWORD=

# Frontend
VITE_API_BASE_URL=http://localhost:4000
