# Backend
API_PORT=4000
MQTT_TCP_PORT=1883
MQTT_WS_PATH=/mqtt
# embedded = this app starts a local Aedes broker.
# external = this app connects to your EMQX TCP listener and publishes commands there.
MQTT_MODE=embedded
EMQX_HOST=
EMQX_PORT=1883
EMQX_TLS=false
EMQX_VALIDATE_CERTIFICATE=true
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_CLIENT_ID=kersen-esl-cloud
JWT_SECRET=change-me-before-production
CORS_ORIGIN=http://localhost:5173
CONSOLE_URL=http://localhost:5173
# For real base stations, set this to a LAN IP or public domain, never localhost.
PUBLIC_SERVER_URL=http://YOUR_LAN_IP:4000
DATABASE_URL=postgresql://kersen:kersen_dev_password@localhost:5432/kersen_esl?schema=public
REDIS_URL=redis://localhost:6379
UPLOAD_DIR=uploads
ESL_AP_REFRESH_CONCURRENCY=6
ESL_AP_REFRESH_SLOT_HOLD_MS=30000
ESL_REFRESH_WORKER_CONCURRENCY=12
ESL_TASK_CREATE_BATCH_SIZE=50
ESL_REFRESH_AUTO_RETRY=true
ESL_REFRESH_AUTO_RETRY_MAX=1
ESL_REFRESH_RETRY_DELAY_MS=25000
PRISMA_DB_PUSH_ON_START=true

# Optional upstream compatibility target discovered from the legacy platform.
# Put the supplied cloud username/password in your private .env only.
UPSTREAM_CLOUD_URL=http://43.153.107.21
UPSTREAM_STORE_CODE=20248517
UPSTREAM_USERNAME=20248517
UPSTREAM_PASSWORD=

# Turn this on only when you want this app to act as a transparent AP proxy to
# the official cloud. It records official downstream WebSocket frames as
# OFFICIAL-WS-DOWN in 接入日志.
AP_PROXY_OFFICIAL=false
OFFICIAL_CLOUD_URL=http://43.153.107.21
# Optional override. Usually leave empty so /ws?token=... is derived from OFFICIAL_CLOUD_URL.
OFFICIAL_WS_URL=

# Frontend
VITE_API_BASE_URL=http://localhost:4000
